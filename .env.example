# Copy to .env and fill in. With neither key set the app still works end to end:
# sessions are written from the on-device library and read by the device's own voice.

# Writes each session from what she shares. https://platform.claude.com
ANTHROPIC_API_KEY=

# Studio narration with line-by-line timing. https://elevenlabs.io
ELEVENLABS_API_KEY=

# Optional: ElevenLabs voice ids for the three narrators (defaults are stock voices).
# ELEVENLABS_VOICE_NAOMI=
# ELEVENLABS_VOICE_ELODIE=
# ELEVENLABS_VOICE_GIDEON=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Optional
# LIORA_WRITER_MODEL=claude-opus-5-5
# PORT=8787
